# Connect the portfolio inquiry form to your own inbox.
# No account secrets are shipped here. Use local environment values when running the app.
# Email setup: docs/email-setup.md. For a local preview without credentials, use MAIL_MODE=log with npm run dev.

APP_URL=http://localhost:3000 # Origin serving the portfolio page; form requests are checked against it.
HOST=127.0.0.1 # Where the server listens; this loopback value does not expose it to other machines.
PORT=3000 # Port used by npm start. Adjust the dev-server configuration separately.
DB_PATH=.data/app.sqlite # Portfolio inquiries plus their email send results; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Use a unique random password, at least 16 characters, for admin to read submitted inquiries.
OWNER_EMAIL=owner@example.com # Your portfolio contact address; new inquiries are sent here with the visitor as Reply-To.
REVIEWER_EMAIL=reviewer@example.com # This app does not send portfolio inquiries to a separate reviewer; the value is unused.
MAIL_MODE=sandbox # Select sandbox, production, or development-only log for portfolio inquiries.
MAIL_FROM=sender@example.com # From address on portfolio inquiries; use your verified Mailtrap sending domain in production.
MAILTRAP_PRODUCTION_TOKEN= # Production credential for portfolio inquiries; obtain a transactional sending token from your Mailtrap account.
MAILTRAP_SANDBOX_TOKEN= # Token authorizing Sandbox captures; use the API credentials shown for your Mailtrap inbox.
MAILTRAP_INBOX_ID= # Sandbox destination for portfolio inquiries: copy the numeric inbox ID from integration settings, not its name.
